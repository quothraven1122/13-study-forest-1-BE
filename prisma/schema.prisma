generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model Study{
  id            Int       @id @default(autoincrement())
  name          String
  description   String
  password      String
  nickname      String
  point         Int       @default(0)
  background    String

  reactions     Reaction[]
  habits        Habit[]

  @@map("studies")
}

model Reaction{
  id        Int       @id @default(autoincrement())
  emoji     String  

  studyId   Int
  study     Study     @relation(fields: [studyId], references: [id])
  @@map("reactions")
}

model Habit{
  id          Int       @id @default(autoincrement())
  name        String

  habitLogs   HabitLog[] 

  studyId     Int
  study       Study     @relation(fields: [studyId], references: [id])
  @@map("habits")
}

model HabitLog{
  id          Int       @id @default(autoincrement())
  date        DateTime  
  completed   Boolean   @default(false)

  habitId     Int
  habit       Habit     @relation(fields: [habitId], references: [id])
  @@map("habitLogs")
}